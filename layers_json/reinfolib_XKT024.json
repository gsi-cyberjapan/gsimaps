{
  "version": 8,
  "name": "高度利用地区【都市計画決定GISデータ】",
  "metadata": {
    "maputnik:renderer": "mlgljs"
  },
  "sources": {
    "XKT024": {
      "type": "vector",
      "tiles": [
        "https://du6jhqfvlioa4.cloudfront.net/ex-api/external/XKT024/{z}/{x}/{y}.pbf"
      ],
      "minzoom": 11,
      "maxzoom": 15,
      "attribution": "<a href=\"https://blog.geolonia.com/2025/04/18/mlit-estate-library-proxy-api\">Geolonia</a>（国土交通省<a href=\"https://www.reinfolib.mlit.go.jp/\">不動産情報ライブラリ</a>(<a href=\"https://nlftp.mlit.go.jp/ksj/\">国土数値情報</a>"
    }
  },
  "glyphs": "https://glyphs.geolonia.com/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "high_use_area_fill",
      "type": "fill",
      "source": "XKT024",
      "source-layer": "hits",
      "minzoom": 11,
      "maxzoom": 20,
      "layout": {
        "visibility": "visible"
      },
      "paint": {
        "fill-color": "#CF2020",
        "fill-opacity": 0.2
      }
    },    {
      "id": "high_use_area_outline",
      "type": "line",
      "source": "XKT024",
      "source-layer": "hits",
      "minzoom": 11,
      "maxzoom": 20,
      "layout": {
        "visibility": "visible"
      },
      "paint": {
        "line-color": "#CF2020",
        "line-width": 1.5,
        "line-opacity": 1
      }
    },    {
      "id": "high_use_area_label",
      "type": "symbol",
      "source": "XKT024",
      "source-layer": "hits",
      "minzoom": 15,
      "maxzoom": 20,
      "layout": {
        "text-field": [
          "coalesce",
          ["get", "advanced_name"],
          ""
        ],
        "text-size": 14,
        "text-anchor": "center",
        "text-font": ["Noto Sans CJK JP Regular"],
        "visibility": "visible",
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#CF2020",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.5
      }
    }
  ]
}