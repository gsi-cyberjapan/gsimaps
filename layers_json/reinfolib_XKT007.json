{
  "version": 8,
  "name": "preschool",
  "metadata": {
    "maputnik:renderer": "mlgljs"
  },
  "sources": {
    "preschool": {
      "type": "vector",
      "tiles": [
        "https://du6jhqfvlioa4.cloudfront.net/ex-api/external/XKT007/{z}/{x}/{y}.pbf"
      ],
      "minzoom": 13,
      "maxzoom": 15,
      "attribution": "<a href=\"https://blog.geolonia.com/2025/04/18/mlit-estate-library-proxy-api\">Geolonia</a>（国土交通省<a href=\"https://www.reinfolib.mlit.go.jp/\">不動産情報ライブラリ</a>(<a href=\"https://nlftp.mlit.go.jp/ksj/\">国土数値情報</a>"
    }
  },
  "glyphs": "https://glyphs.geolonia.com/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "preschool_bg",
      "type": "circle",
      "source": "preschool",
      "source-layer": "hits",
      "minzoom": 13,
      "maxzoom": 20,
      "layout": {
        "visibility": "visible"
      },
      "paint": {
        "circle-radius": 10,
        "circle-color": [
          "case",
            ["==", ["get", "schoolClassCode"], 16011], "#A40035",
            ["==", ["get", "schoolClassCode"], 16013], "#A40035",
            ["==", ["get", "welfareFacilityMiddleClassCode"], "0504"], "#191970",
            "#4169e1"
        ]
      }
    },
    {
      "id": "preschool_point",
      "type": "symbol",
      "source": "preschool",
      "source-layer": "hits",
      "minzoom": 13,
      "maxzoom": 20,
      "layout": {
        "visibility": "visible",
        "text-field": [
          "case",
          ["==", ["get", "schoolClassCode"], 16011], "幼",
          ["==", ["get", "schoolClassCode"], 16013], "こ",
          ["==", ["get", "welfareFacilityMiddleClassCode"], "0504"], "保",
          "他"
        ],
        "text-size": 13,
        "text-font": ["Noto Sans CJK JP Bold"],
        "text-anchor": "center",
        "text-justify": "center",
        "icon-image": "circle",
        "icon-size": 1,
        "icon-text-fit": "both",
        "icon-allow-overlap": true,
        "text-allow-overlap": true
      },
      "paint": {
        "text-color": "#ffffff",
        "icon-color": [
          "case",
          ["==", ["get", "schoolClassCode"], 16011], "#A40035",
          ["==", ["get", "schoolClassCode"], 16013], "#A40035",
          ["==", ["get", "welfareFacilityMiddleClassCode"], "0504"], "#0000cd",
          "#4169e1" 
        ],
        "icon-opacity": 0.9
      }
    },
    {
      "id": "preschool_label",
      "type": "symbol",
      "source": "preschool",
      "source-layer": "hits",
      "minzoom": 15,
      "maxzoom": 20,
      "layout": {
        "text-field": [
          "coalesce",
          ["get", "preSchoolName_ja"],
          ""
        ],
        "text-size": 14,
        "text-anchor": "left",
        "text-offset": [1, 0],
        "text-font": ["Noto Sans CJK JP Regular"],
        "visibility": "visible",
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": [
          "case",
          ["==", ["get", "schoolClassCode"], 16011], "#A40035",
          ["==", ["get", "schoolClassCode"], 16013], "#A40035",
          ["==", ["get", "welfareFacilityMiddleClassCode"], "0504"], "#0000cd",
          "#0000cd" 
        ],
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.5
      }
    }
  ]
}